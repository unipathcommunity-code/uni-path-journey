# ─────────────────────────────────────────────────────────────────────────────
# UniPath SaaS — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in your Supabase project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ── App ───────────────────────────────────────────────────────────────────────
# The base domain for your SaaS platform
# e.g. unipath.me  (no https://, no trailing slash)
VITE_APP_DOMAIN=unipath.me

# ── Optional: Telegram Bot ────────────────────────────────────────────────────
# Used if you are running the Telegram bot integration via Supabase Edge Functions
# VITE_TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ── Optional: AI Features ─────────────────────────────────────────────────────
# Required only if AI chat / AI camera analysis features are enabled
# VITE_OPENAI_API_KEY=sk-...

# ─────────────────────────────────────────────────────────────────────────────
# Deployment notes:
#   • For Vercel: add these as Environment Variables in Project Settings → Env Vars
#   • For local dev: copy to .env.local (Vite automatically loads .env.local)
#   • VITE_ prefix is required — Vite only exposes variables with this prefix to the browser
# ─────────────────────────────────────────────────────────────────────────────
